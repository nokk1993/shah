// Шаг — build configuration shared by all targets.
//
// ─────────────────────────── Change these ───────────────────────────
//
// 1. Your bundle ID. It must be unique across all Apple developers: if Xcode
//    says it "is not available" or "Cannot create … provisioning profile",
//    add something to it, e.g. com.nokk1993.shah2 (Latin letters, digits,
//    dots and hyphens only). Change it only then: a new ID is a new app,
//    and the free account allows 10 new App IDs per 7 days.
APP_BUNDLE_ID = com.nokk1993.shah

// 2. Optional: your Team ID. You can leave it empty and instead pick your
//    Team in Xcode → target → Signing & Capabilities (for "Shah" and "ShahWidgets").
DEVELOPMENT_TEAM =

// 3. Which capabilities to sign with:
//    Full                   HealthKit + background delivery + App Group (recommended)
//    NoBackgroundDelivery   if Xcode cannot provision "HealthKit Background Delivery"
//    Basic                  HealthKit only, if Xcode cannot provision App Groups either
//    The app adapts at runtime; see README → «Типові помилки».
SHAH_CAPABILITIES = Full
//
// ─────────────────────────────────────────────────────────────────────

SHAH_APP_GROUP = group.$(APP_BUNDLE_ID)

// iPhone only: no Mac Catalyst, no "Designed for iPad" on Mac or Vision Pro.
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
